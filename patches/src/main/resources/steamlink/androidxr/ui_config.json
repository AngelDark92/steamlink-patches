        "bindings": [
          "/user/hand/left/input/aim/pose",
          "/user/hand/right/input/aim/pose"
        ]
      }
    }
  },
  "output": {
    "hapticAction": {
      "bindings": {
        "/interaction_profiles/oculus/touch_controller": [
          "/user/hand/left/output/haptic",
          "/user/hand/right/output/haptic"
        ]
      }
    }
  }
}
